# Canonical public HTTPS origin and hostname presented by the deployment edge.
KERR_QNM_PUBLIC_BASE_URL=https://mcp.example.com
KERR_QNM_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*

# Single-owner ChatGPT OAuth login. Generate independent random values of at
# least 32 bytes. Store these only in the hosting platform's secret manager.
KERR_QNM_OAUTH_PASSWORD=replace-with-a-long-random-owner-password
KERR_QNM_OAUTH_SIGNING_SECRET=replace-with-an-independent-random-signing-secret

# Optional static token for private smoke tests; ChatGPT does not use this.
# KERR_QNM_MCP_BEARER_TOKEN=replace-with-a-long-random-secret

# Optional: clone a public solver repository into an empty persistent volume.
KERR_QNM_SOLVER_REPOSITORY=https://github.com/owner/solver.git
KERR_QNM_SOLVER_REF=main
